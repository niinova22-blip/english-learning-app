  "package": {
    "name": {
      "en": "YDS Prep",
      "tr": "YDS Hazırlık"
    },
    "summary": {
      "en": "YDS exam prep for Turkish speakers: academic vocabulary, grammar, reading and exam question types.",
      "tr": "YDS'ye hazırlık: akademik kelimeler, gramer, okuma ve sınav soru tipleri."
    }
  },
  "intro": {
    "en": "YDS tests vocabulary, grammar, reading and translation; there is no listening or speaking. So your plan focuses on these four skills and practises every exam question type one by one.",
    "tr": "YDS'de kelime, gramer, okuma ve çeviri soruları var; dinleme ve konuşma yok. Bu yüzden planın bu dört beceriye odaklanır ve sınav soru tiplerini tek tek çalıştırır."
  },
