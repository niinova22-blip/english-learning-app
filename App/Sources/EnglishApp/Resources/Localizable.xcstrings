      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Abonelik, dönem bitiminden en az 24 saat önce iptal edilmezse otomatik olarak yenilenir. Ödeme, satın alma onayında Apple ID hesabından alınır. Aboneliği Ayarlar > Apple ID > Abonelikler bölümünden yönetebilir ve iptal edebilirsin."
          }
        }
      }
